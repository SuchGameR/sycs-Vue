# ---------------------------------------------------------------------------
# Cloudflare Tunnel
# ---------------------------------------------------------------------------
# Zero Trust ダッシュボードで作成した Tunnel のトークンを貼る。
# 取り方: Zero Trust > Networks > Tunnels > <tunnel 名> > Configure の中に、
#         プラットフォーム別のインストール手順として `--token <この値>` がある。
#
# 注意: docker-compose.yml の tunnel サービスは profiles: ["tunnel"] を付けている
#       ので、普通的 `docker compose up -d` では起動しない。有効化するには:
#           docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# OAuth (任意) を Tunnel 経由で使う場合は、承認済み redirect URI を
# https://<公開ホスト名>/api/auth/google/callback
# https://<公開ホスト名>/api/auth/github/callback
# として登録し直す。localhost を指した値のままだと Tunnel 経由のログインは失敗する。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 通話の NAT 越え (TURN)
# ---------------------------------------------------------------------------
# 対称NAT配下の端末同士は STUN だけでは接続できないため、TURN リレーが必要。
# 未設定でも STUN で繋がるネットワークなら通話できるが、モバイル回線などで
# つながりにくい場合は以下を設定する。
#
# 優先順: Cloudflare Calls TURN > 静的 TURN > STUN のみ
#
# (推奨) Cloudflare Calls の TURN — 資格情報をサーバ側で自動発行する。
#   1. Cloudflare ダッシュボード > Realtime (Calls) > TURN > アプリを作成
#   2. 発行された Key ID と API Token を下に入れる
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
#
# (代替) 自前 coturn などの静的 TURN。カンマ区切りで複数指定可。
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:443?transport=tcp
# TURN_USERNAME=
# TURN_PASSWORD=

