{
  "name": "sycs-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd frontend && vite",
    "build": "cd frontend && run-p type-check \"build-only {@}\" --",
    "preview": "cd frontend && vite preview",
    "test:unit": "cd frontend && vitest",
    "build-only": "cd frontend && vite build",
    "type-check": "cd frontend && vue-tsc --build",
    "lint": "cd frontend && run-s lint:*",
    "lint:oxlint": "cd frontend && oxlint . --fix",
    "lint:eslint": "cd frontend && eslint . --config ../configs/eslint.config.ts --fix --cache",
    "format": "cd frontend && prettier --write --experimental-cli src/ --config ../configs/.prettierrc.json",
    "server": "cd backend && node server/index.js",
    "server:dev": "cd backend && nodemon server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/eslint-plugin": "^1.6.13",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.57.0",
    "prettier": "3.8.1",
    "typescript": "~6.0.0",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6",
    "@types/express": "^5.0.0",
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
