{
  "name": "sycs-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node patch-vite.js",
    "dev": "bun run-p dev:ui dev:server dev:ready",
    "dev:ui": "cd frontend && bunx --bun vite --host",
    "dev:server": "cd backend && bun --watch server/index.js",
    "dev:ready": "bun x wait-on http://localhost:5173 ",
    "build": "bun run-p type-check \"build-only {@}\" --",
    "start": "cd frontend/dist && bun x serve && bun ready.js",
    "clear-db": "bun backend/server/init-db.js",
    "build-only": "vite build frontend/",
    "type-check": "vue-tsc --noEmit -p frontend/tsconfig.app.json --composite false",
    "test:unit": "cd frontend && bun x vitest",
    "lint": "cd frontend && bun run-s lint:*",
    "format": "cd frontend && bun x prettier --write --experimental-cli src/ --config ../configs/.prettierrc.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dompurify": "^3.4.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.3",
    "multer": "^2.1.1",
    "pg": "^8.13.1",
    "pinia": "^3.0.4",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.31",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^5.0.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/eslint-plugin": "^1.6.13",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "nodemon": "^3.1.9",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.57.0",
    "prettier": "3.8.1",
    "typescript": "~6.0.0",
    "vite": "^8.0.11",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6",
    "wait-on": "^9.0.5"
  },
  "resolutions": {
    "postcss": "^8.5.10",
    "http-proxy": "1.18.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "module": "index.ts"
}
